{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (console)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/USTACLI/bin/Debug/net7.0/usta-cli.dll",
      "args": [
        "results",
        "-u",
        "2005791848"
      ],
      "cwd": "${workspaceFolder}/USTACLI",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
